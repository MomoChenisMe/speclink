# Rust build artifacts
/target/
# napi build 的隔離 target（見 crates/adapters/speclink-node/.cargo/config.toml）
/crates/adapters/speclink-node/target/

# Legacy app data
openspec/.vector-search.db*

# Speclink app data
.speclink/

# JS workspace (desktop app + shared UI + server web console)
node_modules/
apps/desktop/dist/
apps/desktop/src-tauri/gen/
# Server Web Console 的 Vite 產物：不入版本控制，各 build path（dev／CI／Docker／
# release）皆重建後由 speclink-server 內嵌（D5）。
apps/server-web/dist/

# Deployment secrets（deploy/.env.example 是入版本控制的樣板）
deploy/.env

# 本地開發編排（npm run dev；.env.example 是入版本控制的樣板）
/.dev/
/.env

# macOS
.DS_Store
apps/desktop/src-tauri/binaries/

# Claude Code 載入 mod 時自動產生的型別檔，每次載入都會重寫
integrations/claude-code/*/.claude-plugin/types/

# 品牌套件壓縮檔不進 repo（原稿在 docs/assets/brand/svg）
docs/assets/brand/*.zip
