{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Speclink 桌面 app 的預設能力集",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "clipboard-manager:allow-write-text",
    "core:tray:default",
    "core:tray:allow-set-title",
    "core:menu:default",
    "core:image:allow-from-bytes",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/MomoChenisMe/speclink*" },
        { "url": "https://github.com/OWASP/*" },
        { "url": "https://raw.githubusercontent.com/OWASP/*" },
        { "url": "https://cwe.mitre.org/data/*" },
        { "url": "https://cwe.mitre.org/about/termsofuse.html" }
      ]
    }
  ]
}
