{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speclink",
  "version": "0.1.2",
  "identifier": "app.speclink.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Speclink",
        "width": 1440,
        "height": 900,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENENUVFM0ZBRUUwNzIxRUYKUldUdklRZnUrdU5lemFRbDFNYml0TFBkQ3cyRmpzUFQ4WmpBdGRvMmlSZ0tGaXV1dVQ1dmNBdnIK",
      "endpoints": [
        "https://github.com/MomoChenisMe/speclink/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/speclink"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "localizations/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "localizations/zh_TW.lproj/InfoPlist.strings": "zh_TW.lproj/InfoPlist.strings"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "languages": ["TradChinese", "English"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
