{
  "name": "@speclink/engine",
  "version": "0.1.0",
  "description": "Speclink spec-driven development engine — Node.js bindings (napi-rs)",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">= 18"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "binding.js"
  ],
  "napi": {
    "name": "speclink-engine",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-pc-windows-msvc",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --js binding.js --dts binding.d.ts",
    "build:release": "napi build --platform --release --js binding.js --dts binding.d.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@speclink/engine-win32-x64-msvc": "0.1.0",
    "@speclink/engine-darwin-x64": "0.1.0",
    "@speclink/engine-darwin-arm64": "0.1.0",
    "@speclink/engine-linux-x64-gnu": "0.1.0",
    "@speclink/engine-linux-arm64-gnu": "0.1.0"
  }
}
