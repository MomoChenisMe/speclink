# 複製為 .env 後填值（.env 已入 .gitignore，不進版本控制）。
#   cp .env.example .env

# PostgreSQL profile 必填：資料庫密碼（同一值同時初始化 postgres 服務
# 與補全 server 的連線 URL）。
SPECLINK_POSTGRES_PASSWORD=

# 對外網址：瀏覽器實際使用的 scheme://host:port（同源檢查與 setup 連結都以此為準）。
#SPECLINK_PUBLIC_URL=http://localhost:8080

# 對外埠映射（容器內固定 8080）。
#SPECLINK_PORT=8080
